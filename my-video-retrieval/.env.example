# --- Video Retrieval UI — environment overrides (optional) --------------------
# Copy to my-video-retrieval/.env and adjust as needed. All variables are
# prefixed with VRI_ and override the defaults in config/settings.py.
# A workspace-level My_Code/.env is also read (app-level wins).

# Dataset discovery (glob under the workspace root; e.g. L25_data, L30_data)
#VRI_DATASET_GLOB=*_data

# Per-dataset subdirectories
#VRI_CAPTIONS_SUBDIR=captions
#VRI_EMBEDDINGS_SUBDIR=caption_embeddings
#VRI_VIDEOS_SUBDIR=videos
#VRI_KEYFRAMES_SUBDIR=keyframes
#VRI_SHOTS_SUBDIR=shots

# Video titles CSV (relative or absolute)
#VRI_TITLES_CSV=d:/Truong_pipeline/My_Code/all_video_titles_and_links.csv

# Embedding model + dimension (MUST match the stored .npy vectors)
#VRI_EMBED_MODEL=BAAI/bge-m3
#VRI_EMBED_DIM=1024

# LanceDB index location + table name
#VRI_LANCEDB_URI=d:/Truong_pipeline/My_Code/my-video-retrieval/data/index
#VRI_TABLE_NAME=shots

# Search defaults
#VRI_DEFAULT_TOP_K=10
#VRI_MAX_TOP_K=50
#VRI_RRF_K=60

# BM25 (Tantivy) full-text settings
#VRI_FTS_TOKENIZER=simple
#VRI_FTS_ASCII_FOLDING=True
#VRI_FTS_LANGUAGE=English

# Visual scoring (SigLIP over keyframes)
#VRI_SIGLIP_MODEL=google/siglip-so400m-patch14-384
#VRI_SIGLIP_DIM=1152
#VRI_KEYFRAME_EMBEDDINGS_SUBDIR=keyframe_embeddings

# Hugging Face (recommended to reduce rate-limit warnings)
#HF_TOKEN=your-hf-token-here
#HF_HUB_DISABLE_TELEMETRY=1